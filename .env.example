# Copy to `.env` and fill in real values. Never commit your real .env file.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false
PORT=5000

# Paths (optional overrides)
# DB_PATH=database/placement.db
# MODEL_PATH=model.pkl

# Default admin seeded on first run (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Set to true when serving over HTTPS in production
SESSION_COOKIE_SECURE=false

# Optional LLM providers for AI modules (leave blank if unused)
OPENAI_API_KEY=
GEMINI_API_KEY=
