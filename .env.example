# .env.example — Copy to .env and fill in real values before running locally.
# On Render/Railway, set these in the dashboard → Environment Variables.

# ─── Flask ────────────────────────────────────────────────────
# REQUIRED — use a long random string in production
SECRET_KEY=PlacementAI_2026_Secure_Key_12345
# REQUIRED — used for password-reset token signing
SECURITY_SALT=PlacementAI_Salt_2026
# Set to 'development' when running locally
FLASK_ENV=development

# Optional: enable debug mode locally (NEVER set to 1 in production)
# FLASK_DEBUG=1

# Optional: override model path (defaults to model.pkl in project root)
# MODEL_PATH=/path/to/model.pkl

# ─── Supabase / PostgreSQL ────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection info
SUPABASE_DB_PASSWORD=your-supabase-database-password
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-database-password

